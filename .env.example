# ---------------------------------------------------------------------------
# Modèle de configuration.
#
# Copie ce fichier en « .env.local » et remplis les valeurs.
# .env.local est ignoré par Git : les vraies clés ne partent JAMAIS sur GitHub.
#
# À l'étape 0, seule NEXT_PUBLIC_SITE_URL est utilisée.
# Les autres variables sont listées pour mémoire et seront remplies plus tard.
# ---------------------------------------------------------------------------

# URL publique du site (sert aux liens canoniques, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Étape 1 : Supabase ----------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète : utilisée uniquement côté serveur, jamais exposée au navigateur
# SUPABASE_SERVICE_ROLE_KEY=


# --- Étape 3 : administration ----------------------------------------------
# Seul cet email pourra accéder à /admin
# ADMIN_EMAIL=


# --- Étape 16 : analytics --------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GOOGLE_SITE_VERIFICATION=
