# ---------------------------------------------------------------------------
# Modèle de configuration.
#
# Copie ce fichier en « .env.local » et remplis les valeurs.
# .env.local est ignoré par Git : les vraies clés ne partent JAMAIS sur GitHub.
#
# Les variables des étapes suivantes sont listées pour mémoire et seront
# remplies plus tard.
# ---------------------------------------------------------------------------

# URL publique du site (sert aux liens canoniques, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Étape 1 : Supabase ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète : utilisée uniquement côté serveur (étape 4, CRUD admin), jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=


# --- Étape 3 : administration ----------------------------------------------
# Seul cet email pourra accéder à /admin (doit correspondre exactement au
# compte créé dans Supabase Auth)
ADMIN_EMAIL=


# --- Étape 15 : SEO ---------------------------------------------------------
# Code de vérification Google Search Console (balise meta), à récupérer
# lors de l'ajout de la propriété dans Search Console. Facultatif : sans
# valeur, la balise n'est simplement pas générée.
# GOOGLE_SITE_VERIFICATION=


# --- Étape 16 : analytics --------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
